TELEGRAM_TOKEN=
TALAGRAM_ALLOW_USERS=
# Optional HTTP(S) or SOCKS5 proxy URL used for Telegram API calls.
TELEGRAM_PROXY=
# SQLite database path (mounted from ./data in Docker Compose).
DATABASE_PATH=/app/data/tg-net-bot.sqlite
# Shared short-lived Cheburcheck probe context cache.
REDIS_ADDR=127.0.0.1:6379
# Optional Redis password. Keep empty when Redis has no password configured.
REDIS_PASSWORD=
# Local retention for manual Cheburcheck probe context (not upstream ID validity).
BLOCKCHECK_CACHE_TTL=3h
